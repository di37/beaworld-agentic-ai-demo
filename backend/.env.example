# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=your_openai_api_key

# Optional settings (defaults shown)
# BEA_MODEL=gpt-5.6-luna
# BEA_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=            # an OpenAI-compatible server, e.g. a local vLLM
# BEA_USE_RESPONSES_API=1     # default 1 for OpenAI, 0 when OPENAI_BASE_URL is set
# BEA_REQUEST_TIMEOUT=60
# BEA_HOST=127.0.0.1
# BEA_PORT=8791
# BEA_RATE_LIMIT_PER_MINUTE=30
# BEA_OPEN_BROWSER=1          # set to 0 to stop the browser opening on start
